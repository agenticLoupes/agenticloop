# DentAssist Guardian — backend environment (copy to .env, fill in, never commit .env)

# Supabase Postgres — use the POOLER connection string (Session mode), not the
# direct db.<ref>.supabase.co host (that host is IPv6-only and won't resolve on IPv4).
# Dashboard → Settings → Database → Connection string → Session pooler → URI
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google Gemini via Google AI Studio (free tier) — https://aistudio.google.com → Get API key
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TypeSafe / Jev (Skeptic decisions) — https://typesafe.ai dashboard
TYPESAFE_API_KEY=
