# Root environment template for the verification helper.
# The backend reads backend/.env when launched manually from the backend directory.
# Copy this file to .env for verify.sh or to backend/.env for a manual launch.

# Supabase Postgres session-pooler connection string.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google Gemini through Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TypeSafe Jev for Skeptic decisions.
TYPESAFE_API_KEY=
